<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Synonym Guess Game - Class 7</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:linear-gradient(135deg,#6dd5ed,#2193b0);
min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
padding:20px;
}

.container{
background:white;
width:900px;
max-width:100%;
border-radius:25px;
padding:25px;
box-shadow:0 10px 30px rgba(0,0,0,.2);
animation:pop .6s ease;
}

@keyframes pop{
from{
transform:scale(.8);
opacity:0;
}
to{
transform:scale(1);
opacity:1;
}
}

h1{
text-align:center;
color:#2193b0;
margin-bottom:15px;
}

.progress{
height:15px;
background:#ddd;
border-radius:20px;
overflow:hidden;
margin-bottom:20px;
}

.progress-bar{
height:100%;
width:0%;
background:linear-gradient(to right,#00c853,#64dd17);
transition:.5s;
}

.question{
font-size:30px;
font-weight:bold;
text-align:center;
margin:20px 0;
color:#333;
}

.instruction{
text-align:center;
margin-bottom:20px;
font-size:18px;
}

.options{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.option{
background:#f8f8f8;
border:4px solid transparent;
border-radius:20px;
padding:15px;
cursor:pointer;
transition:.4s;
text-align:center;
}

.option:hover{
transform:translateY(-8px);
}

.option img{
width:100%;
height:250px;
object-fit:cover;
border-radius:15px;
}

.option h3{
margin-top:10px;
}

.correct{
background:#d4edda;
border-color:#28a745;
animation:bounce .5s;
}

.wrong{
background:#f8d7da;
border-color:#dc3545;
animation:shake .5s;
}

@keyframes bounce{
50%{
transform:scale(1.08);
}
}

@keyframes shake{
25%{transform:translateX(-8px);}
50%{transform:translateX(8px);}
75%{transform:translateX(-8px);}
}

.feedback{
text-align:center;
font-size:28px;
font-weight:bold;
margin:20px;
min-height:50px;
}

.next-btn{
display:none;
margin:auto;
padding:12px 35px;
font-size:20px;
border:none;
border-radius:30px;
background:#2193b0;
color:white;
cursor:pointer;
}

.next-btn:hover{
background:#176d88;
}

.score-screen{
display:none;
text-align:center;
}

.score-screen h2{
font-size:40px;
color:#2193b0;
}

.score-screen p{
font-size:25px;
margin-top:20px;
}
</style>
</head>

<body>

<div class="container">

<h1>🌟 Synonym Guessing Game 🌟</h1>

<div class="progress">
<div class="progress-bar" id="bar"></div>
</div>

<div id="quiz">

<div class="question" id="word"></div>
<div class="instruction">Choose the correct synonym!</div>

<div class="options">

<div class="option" id="a" onclick="checkAnswer('a')">
<img id="imgA">
<h3 id="textA"></h3>
</div>

<div class="option" id="b" onclick="checkAnswer('b')">
<img id="imgB">
<h3 id="textB"></h3>
</div>

</div>

<div class="feedback" id="feedback"></div>

<button class="next-btn" onclick="nextQuestion()">Next ➜</button>

</div>

<div class="score-screen" id="scoreScreen">
<h2>🏆 Game Completed!</h2>
<p id="finalScore"></p>
</div>

</div>

<script>

const questions = [

{
word:"Defenders",
correct:"Protectors",
wrong:"Attackers",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500",
imgB:"https://images.unsplash.com/photo-1505666287802-931dc83a7f1?w=500"
},

{
word:"Scorching",
correct:"Very Hot",
wrong:"Very Cold",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=500",
imgB:"https://images.unsplash.com/photo-1482192596544-9eb780fc7f66?w=500"
},

{
word:"Deed",
correct:"Action",
wrong:"Dream",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=500",
imgB:"https://images.unsplash.com/photo-1517842645767-c639042777db?w=500"
},

{
word:"Marshes",
correct:"Wet Land",
wrong:"Desert",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=500",
imgB:"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=500"
},

{
word:"Sweltering",
correct:"Extremely Hot",
wrong:"Freezing",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=500",
imgB:"https://images.unsplash.com/photo-1457269449834-928af64c684d?w=500"
},

{
word:"Treading",
correct:"Walking Carefully",
wrong:"Running Fast",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?w=500",
imgB:"https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=500"
},

{
word:"Expanse",
correct:"Wide Area",
wrong:"Small Room",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=500",
imgB:"https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=500"
},

{
word:"Yogis",
correct:"Meditators",
wrong:"Dancers",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=500",
imgB:"https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=500"
},

{
word:"Striding",
correct:"Walking Confidently",
wrong:"Crawling",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500",
imgB:"https://images.unsplash.com/photo-1545239351-1141bd82e8a6?w=500"
},

{
word:"Surveillance",
correct:"Watching Carefully",
wrong:"Sleeping",
correctOption:"a",
imgA:"https://images.unsplash.com/photo-1496171367470-9ed9a91ea931?w=500",
imgB:"https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500"
}

];

let current=0;
let score=0;

loadQuestion();

function loadQuestion(){

let q=questions[current];

document.getElementById("word").innerText=q.word;

document.getElementById("textA").innerText=
q.correctOption==="a"?q.correct:q.wrong;

document.getElementById("textB").innerText=
q.correctOption==="b"?q.correct:q.wrong;

document.getElementById("imgA").src=q.imgA;
document.getElementById("imgB").src=q.imgB;

document.getElementById("feedback").innerHTML="";

document.querySelector(".next-btn").style.display="none";

document.getElementById("a").className="option";
document.getElementById("b").className="option";

let progress=((current)/questions.length)*100;
document.getElementById("bar").style.width=progress+"%";
}

function checkAnswer(choice){

let q=questions[current];

document.getElementById("a").onclick=null;
document.getElementById("b").onclick=null;

if(choice===q.correctOption){

document.getElementById(choice).classList.add("correct");

document.getElementById("feedback").innerHTML=
"⭐ Excellent! Correct Answer!";

score++;

}
else{

document.getElementById(choice).classList.add("wrong");

document.getElementById(q.correctOption).classList.add("correct");

document.getElementById("feedback").innerHTML=
"❌ Good Try! Keep Going!";
}

document.querySelector(".next-btn").style.display="block";
}

function nextQuestion(){

current++;

if(current<questions.length){

loadQuestion();

document.getElementById("a").onclick=()=>checkAnswer("a");
document.getElementById("b").onclick=()=>checkAnswer("b");

}
else{

document.getElementById("quiz").style.display="none";
document.getElementById("scoreScreen").style.display="block";

document.getElementById("bar").style.width="100%";

document.getElementById("finalScore").innerHTML=
`🎉 Your Score: ${score}/10`;
}
}

</script>

</body>
</html>